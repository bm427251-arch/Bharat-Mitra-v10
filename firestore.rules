rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and authentication documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rides and booking requests
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /rides/{rideId} {
      allow read, write: if request.auth != null;
    }

    match /rent_bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /driver_bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    // App configuration and fare rates
    match /app_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Rental vehicle listings
    match /rent_vehicles/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Service providers / Sebaks
    match /sebaks/{sebakId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Subscriptions, feedbacks and complaints
    match /subscriptions/{subId} {
      allow read, write: if request.auth != null;
    }

    match /complaints/{complaintId} {
      allow read, write: if request.auth != null;
    }

    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    match /rent_owners/{id} { allow create: if request.auth != null; allow read: if true; allow update: if request.auth.uid == resource.data.uid; }
    match /drivers/{id} { allow create: if request.auth != null; allow read: if true; allow update: if request.auth.uid == resource.data.uid; }
    match /service_providers/{id} { allow create: if request.auth != null; allow read: if true; allow update: if request.auth.uid == resource.data.uid; }
    match /driver_reviews/{id} { allow create: if request.auth != null; allow read: if true; }
    match /rent_owner_reviews/{id} { allow create: if request.auth != null; allow read: if true; }
    match /service_provider_reviews/{id} { allow create: if request.auth != null; allow read: if true; }
    match /package_purchases/{id} { allow read: if request.auth != null; allow create: if request.auth != null; }
  }
}
