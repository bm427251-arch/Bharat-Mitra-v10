rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /rent_owners/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /drivers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /service_providers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
